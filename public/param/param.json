{
    "title": "用户信息",
    "production": true,
    "productionTitle": "提示",
    "titleBtns": [
        {"label": "按钮",
        "func": "func1"
        }
    ],
    "endBtns": [
        {"type": "primary",
        "label": "确定",
        "func": "submit"
        },
        {"buttonColor": "#774ef7",
        "label": "取消"
        }
    ],
    "fromUi": {
        "col": 2
    },
    "fromSchema":[
        {
          "prop":"name",
            "inputtype": "rtinput",
            "title": "姓名",
            "btnWidth": 30,
            "rules": [{"type":"required"},{"type":"phoneNo"}],
            "showExBtn": true,
            "btnItems":{
                "label": "测试塞值",
                "buttonColor": "#774ef7",
                "func": "setTbaleValue"
            }
          },
          {
            "prop": "age",
            "inputtype": "rtinput",
            "title": "年龄",
            "btnWidth": 30,
            "rules": [{"type":"byrtInput","trigger":"blur"}]
          },
          {
            "prop": "edittable",
            "inputtype": "rttable",
            "title": "这是一个可编辑的表格",
            "editFlag": true,
            "showExpand": true,
            "fromUi":{
                "cols": 2
            },
            "fromSchema": [
                {
                    "prop": "name",
                    "inputtype": "rtinput",
                    "title": "这是input",
                    "rules": [{"type":"required"}]
                  },
                  {
                    "prop": "select",
                    "inputtype": "rtSelectV2",
                    "title": "这是下拉选",
                    "tag": true,
                    "loadData": [
                      {
                        "label": "主险",
                        "value": "1",
                        "color": "#FF6600"
                      },
                      {
                        "label": "附加险",
                        "value": "2",
                        "color": "#14CCCC"
                      }
                    ]
                  },
                  {
                    "prop": "date",
                    "inputtype": "rtdatepicker",
                    "title": "这是datepicker",
                    "expand": true
                  }
            ]
          }
          
    ]
    
}